      "RetailerOrders": {
        "title": "RetailerOrders",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RetailerOrder"
        }
      },
      "RetailerSelection": {
        "title": "RetailerSelection",
        "properties": {
          "id": {
            "type": "integer"
          },
          "create_time": {
            "type": "string"
          },
          "update_time": {
            "type": "string"
          },
          "brand_name": {
            "type": "string"
          },
          "buyer_name": {
            "type": "string"
          },
          "buyer_first_name": {
            "type": "string"
          },
          "buyer_email": {
            "type": "string"
          },
          "comment": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetailerSelectionItem"
            }
          }
        },
        "type": "object"
      },
      "RetailerSelectionItem": {
        "title": "RetailerSelectionItem",
        "properties": {
          "product_model": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_reference": {
            "type": "string"
          },
          "variant_name": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RetailerSelections": {
        "title": "RetailerSelections",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RetailerSelection"
        }
      }
    },
    "responses": {
      "AuthRateLimitExceeded": {
        "description": "Too many credential exchanges for this client id in one minute. This limit applies before the client secret is checked and is separate from the per-token limit below.",
        "headers": {
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait before retrying"
          }
        }
      },
      "RateLimitExceeded": {
        "description": "API call rate limit has been exceeded (60 requests per minute per token)",
        "headers": {
          "X-RateLimit-Limit": {
            "schema": {
              "type": "integer"
            },
            "description": "Maximum requests allowed per minute"
          },
          "X-RateLimit-Remaining": {
            "schema": {
              "type": "integer"
            },
            "description": "Requests remaining in current window (0 when exceeded)"
          },
          "X-RateLimit-Reset": {
            "schema": {
              "type": "integer"
            },
            "description": "Unix timestamp when the window resets"
          },
          "X-RateLimit-Reset-Time": {
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "ISO 8601 timestamp when the window resets"
          },
          "Retry-After": {
            "schema": {
              "type": "integer"
            },
            "description": "Seconds to wait before retrying"
          },
          "X-RateLimit-Request-Count": {
            "schema": {
              "type": "integer"
            },
            "description": "Current request count in window"
          },
          "X-RateLimit-Request-Period": {
            "schema": {
              "type": "integer"
            },
            "description": "Internal period identifier"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 429
                    },
                    "message": {
                      "type": "string",
                      "example": "API call rate limit has been exceeded."
                    },
                    "message_user_friendly": {
                      "type": "string",
                      "example": ""
                    },
                    "type": {
                      "type": "string",
                      "example": "UserException"
                    }
                  }
                },
                "response": {
                  "type": "null"
                }
              }
            }
          }
        }
      }
    }
  },
  "x-rate-limiting": {
    "description": "All API endpoints are subject to rate limiting on a per-token basis. The rate limit is enforced using a 60-second sliding window. Every API response includes rate limit headers, even when the limit is not exceeded.\n",
    "default-limit": 60,
    "window": "60s",
    "scope": "per access_token (global, not per endpoint)",
    "headers": {
      "X-RateLimit-Limit": {
        "description": "Maximum number of requests allowed per minute",
        "example": 60
      },
      "X-RateLimit-Remaining": {
        "description": "Number of requests remaining in the current window",
        "example": 42
      },
      "X-RateLimit-Reset": {
        "description": "Unix timestamp when the current window resets",
        "example": 1743696540
      },
      "X-RateLimit-Reset-Time": {
        "description": "ISO 8601 timestamp when the current window resets",
        "example": "2025-04-02T14:22:00+0100"
      },
      "Retry-After": {
        "description": "Seconds to wait before retrying (only relevant on 429)",
        "example": 45
      },
      "X-RateLimit-Request-Count": {
        "description": "Current request count in the active window",
        "example": 18
      },
      "X-RateLimit-Request-Period": {
        "description": "Internal period identifier (unix timestamp / 60)",
        "example": 29061609
      }
    },
    "error-response": {
      "status": 429,
      "body": {
        "error": {
          "code": 429,
          "message": "API call rate limit has been exceeded.",
          "message_user_friendly": "",
          "type": "UserException"
        },
        "response": null
      }
    }
  }
}
