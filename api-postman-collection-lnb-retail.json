          },
          "sku": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RetailerOrderLineExtra": {
        "title": "RetailerOrderLineExtra",
        "properties": {
          "product_model": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_reference": {
            "type": "string"
          },
          "variant_name": {
            "type": "string"
          },
          "bulk_quantity": {
