    },
    "/version": {
      "get": {
        "tags": [
          "Version"
        ],
        "summary": "Get API version",
        "description": "Get API version info",
        "operationId": "getVersion",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiVersion"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
