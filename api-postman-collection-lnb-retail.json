        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetailerOrder"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      }
    },
    "/selections": {
      "get": {
        "tags": [
          "Selections"
        ],
        "summary": "Get selections",
        "description": "Get all selections",
        "operationId": "getAllSelections",
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
