    }
  },
  "components": {
    "securitySchemes": {
      "oauth2_access_token": {
        "type": "apiKey",
        "name": "access_token",
        "in": "query",
        "description": "OAuth 2.0 access token"
      }
    },
    "schemas": {
      "ApiVersion": {
        "title": "ApiVersion",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "AuthToken": {
        "title": "AuthToken",
        "properties": {
          "access_token": {
            "description": "A token to be added as a query parameter to every subsequent API request. This token will authorize and authenticate your API requests.",
            "type": "string"
          },
          "expire_on": {
            "description": "A date-time indicating when the token will expire.",
            "type": "string"
          },
          "scope": {
            "description": "A scope for this token. This is currently always set to 'retailer'.",
            "type": "string",
            "default": "Brand"
          },
          "token_type": {
            "description": "A type for this token. This is currently always set to 'Bearer'.",
            "type": "string",
            "default": "Bearer"
          }
        },
        "type": "object"
      },
      "AuthTokenRequest": {
        "title": "AuthTokenRequest",
        "properties": {
          "client_id": {
            "description": "A client id as provided in your Le New Black account.",
            "type": "string"
          },
          "client_secret": {
            "description": "A client secret as provided in your Le New Black account.",
            "type": "string"
          },
          "grant_type": {
            "description": "The authentication type being used. Must always be 'client_credentials'.",
            "type": "string",
            "default": "client_credentials"
          }
        },
        "type": "object"
      },
      "RetailerContact": {
        "title": "RetailerContact",
        "properties": {
          "id": {
            "type": "integer"
          },
          "create_time": {
            "type": "string"
          },
          "update_time": {
            "type": "string"
          },
          "brand_name": {
            "type": "string"
          },
          "buyer_last_name": {
            "type": "string"
          },
          "buyer_first_name": {
            "type": "string"
          },
          "buyer_email": {
            "type": "string"
          },
          "season": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "attendees_total": {
            "type": "integer"
          },
          "schedule_from_time": {
            "type": "string"
          },
          "schedule_to_time": {
            "type": "string"
          },
          "done_from_time": {
            "type": "string"
          },
          "done_to_time": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RetailerContacts": {
        "title": "RetailerContacts",
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RetailerContact"
        }
      },
      "RetailerOrder": {
        "title": "RetailerOrder",
        "properties": {
          "id": {
            "type": "integer"
          },
          "create_time": {
            "type": "string"
          },
          "update_time": {
            "type": "string"
          },
          "confirmation_time": {
            "type": "string"
          },
          "cancellation_time": {
            "type": "string"
          },
          "delivery_start_on": {
            "type": "string"
          },
          "delivery_end_on": {
            "type": "string"
          },
          "notify_email": {
            "type": "string"
          },
          "notify_email_cc": {
            "type": "string"
          },
          "notify_message": {
            "type": "string"
          },
          "brand_name": {
            "type": "string"
          },
          "buyer_name": {
            "type": "string"
          },
          "buyer_first_name": {
            "type": "string"
          },
          "buyer_email": {
            "type": "string"
          },
          "sales_person_name": {
            "type": "string"
          },
          "sales_person_first_name": {
            "type": "string"
          },
          "sales_person_email": {
            "type": "string"
          },
          "price_total": {
            "type": "number"
          },
          "price_total_prediscount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "examples": [
              "EUR"
            ]
          },
          "discount_rate": {
            "type": "number"
          },
          "delivery_incoterm_ref": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "examples": [
              "Confirmed"
            ]
          },
          "terms": {
            "type": "string"
          },
          "terms_of_delivery": {
            "type": "string"
          },
          "terms_of_payment": {
            "type": "string"
          },
          "billing_address": {
            "type": "object"
          },
          "delivery_address": {
            "type": "object"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetailerOrderItem"
            }
          },
          "lines_extra": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RetailerOrderLineExtra"
            }
          }
        },
        "type": "object"
      },
      "RetailerOrderItem": {
        "title": "RetailerOrderItem",
        "properties": {
          "create_time": {
            "type": "string"
          },
          "product_model": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_reference": {
            "type": "string"
          },
          "variant_name": {
            "type": "string"
          },
          "size_name": {
            "type": "string",
            "examples": [
              "XS"
            ]
          },
          "unit_price": {
            "type": "number"
          },
          "quantity": {
            "type": "integer"
          },
          "ean13": {
