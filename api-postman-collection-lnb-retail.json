{
  "openapi": "3.1.0",
  "info": {
    "title": "Le New Black Retailer API",
    "version": "1.0.0",
    "description": "Complete Retailer API documentation"
  },
  "servers": [
    {
      "url": "https://www.lenewblack.com/apis/retail",
      "description": "Production server"
    }
  ],
  "security": [
    {
      "oauth2_access_token": []
    }
  ],
  "tags": [
    {
      "name": "Appointments"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Orders"
    },
    {
      "name": "Selections"
    },
    {
      "name": "Version"
    }
  ],
  "paths": {
    "/appointments": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "Get appointments",
        "description": "Get all appointments",
        "operationId": "getAllAppointments",
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "description": "The access token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetailerContacts"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      }
    },
    "/appointments/{id}": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "Get appointment",
        "description": "Get an appointment by its id",
        "operationId": "getAppointmentById",
        "parameters": [
          {
            "name": "access_token",
            "in": "query",
            "description": "The access token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RetailerContact"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "429": {
            "$ref": "#/components/responses/RateLimitExceeded"
          }
        }
      }
    },
    "/auth/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Retrieve authentication token",
        "description": "You must use this endpoint to obtain an access token and be able to request every other endpoints of this API.",
        "operationId": "authenticate",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthToken"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          },
          "422": {
            "description": "Missing parameters or invalid grant type"
          },
          "429": {
            "$ref": "#/components/responses/AuthRateLimitExceeded"
          }
        }
      }
    },
